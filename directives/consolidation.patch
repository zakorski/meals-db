-            if ($uid <= 0) {
-                continue;
-            }
-
-            $params = $active_statuses;
-            $params[] = $uid;
-            $params[] = $cutoff_date;
-
-            $recent = (int) $wpdb->get_var($wpdb->prepare(
-                "SELECT COUNT(*) FROM `{$orders_table}`
-                 WHERE status IN ({$status_placeholders})
-                   AND type = 'shop_order'
-                   AND customer_id = %d
-                   AND date_created_gmt >= %s",
