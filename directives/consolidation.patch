+            }
+
+            $street_name = $meta['billing_address_1'] ?? null;
+            $city        = $meta['billing_city'] ?? null;
+            $province    = $meta['billing_state'] ?? null;
+            $postal_code = $meta['billing_postcode'] ?? null;
+
+            $del_street_name = $meta['shipping_address_1'] ?? null;
