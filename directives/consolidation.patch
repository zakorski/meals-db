-            ));
-
-            if ($recent === 0) {
-                $stale[] = [
-                    'client_id' => (int) $row['client_id'],
-                    'wp_user_id' => $uid,
-                    'name' => trim(((string) ($row['first_name'] ?? '')) . ' ' . ((string) ($row['last_name'] ?? ''))),
-                ];
-            }
-        }
-
-        return $stale;
-    }
-
-    /**
-     * Deactivate the rows identified by deactivation_sweep_preview().
-     *
-     * @return array{candidates:int, deactivated:int, errors:int}
