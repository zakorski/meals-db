-            $meta_keys = ['billing_address_1', 'billing_address_2', 'shipping_address_1', 'shipping_address_2'];
-            $meta_keys_sql = implode(',', array_map(function ($k) use ($wpdb) {
-                return $wpdb->prepare('%s', $k);
