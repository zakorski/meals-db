+$GLOBALS['wpdb'] = $wpdb3;
+$out = call_p2([['client_id' => 7, 'wp_user_id' => 50, 'default_rate_id' => 1, 'first_name' => 'T', 'last_name' => 'L']], '2025-11');
+chk((int) $out[7]['contribution_cents'], 1977, 'contribution: $19.77 → 1977 cents (Terrence LeBlanc real case)');
