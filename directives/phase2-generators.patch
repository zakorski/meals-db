+chk($basic_cents, 41048, 'Doyle: basic 28 × 14.66 = $410.48');
+chk($contribution_cents, 23669, 'Doyle: contribution = $236.69');
+chk($dept_cents, 17379, 'Doyle: Dept = $173.79');
+
