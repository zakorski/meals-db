-                continue;
-            }
-
-            if ( strpos( $trimmed, 'LOCK TABLES' ) === 0 ) {
-                $in_target = false;
-                $buffer    = '';
-                continue;
-            }
-
-            // Detect start of a new relevant statement
-            if ( ! $in_target ) {
-                $is_target = false;
